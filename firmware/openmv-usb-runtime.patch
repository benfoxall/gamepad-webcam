diff --git a/ports/alif/tinyusb_port/tusb_alif_dcd.c b/ports/alif/tinyusb_port/tusb_alif_dcd.c
index c8f86082..596b015e 100644
--- a/lib/micropython/ports/alif/tinyusb_port/tusb_alif_dcd.c
+++ b/lib/micropython/ports/alif/tinyusb_port/tusb_alif_dcd.c
@@ -480,6 +480,17 @@ void USB_IRQHandler(void)
 
 static uint8_t _dcd_cmd_wait(uint8_t ep, uint8_t typ, uint16_t param)
 {
+    // The USB ISR also issues endpoint commands (XferNotReady/XferComplete
+    // handling), so a command sequence started from thread context must not
+    // be interleaved with it: two DEPCMDs in flight corrupt the command
+    // registers and the cmdact poll below never completes (observed as the
+    // whole USB stack wedging when HID reports and CDC traffic overlap).
+    // Mask the USB IRQ for the duration unless the caller already did.
+    bool irq_enabled = NVIC_GetEnableIRQ(USB_IRQ_IRQn);
+    if (irq_enabled) {
+        NVIC_DisableIRQ(USB_IRQ_IRQn);
+    }
+
     // capture phy state and disable lpm and suspend
     uint32_t phycfg = ugbl->gusb2phycfg0;
     ugbl->gusb2phycfg0_b.enblslpm = 0;
@@ -497,7 +508,11 @@ static uint8_t _dcd_cmd_wait(uint8_t ep, uint8_t typ, uint16_t param)
     // restore phy state
     ugbl->gusb2phycfg0 = phycfg;
 
-    return udev->depcmd[ep].depcmd_b.cmdstatus;
+    uint8_t status = udev->depcmd[ep].depcmd_b.cmdstatus;
+    if (irq_enabled) {
+        NVIC_EnableIRQ(USB_IRQ_IRQn);
+    }
+    return status;
 }
 
 
@@ -695,10 +710,14 @@ static uint8_t _dcd_start_xfer(uint8_t ep, void* buf, uint32_t size, uint8_t typ
     udev->depcmd[ep].par1 = (uint32_t) LocalToGlobal(_xfer_trb[ep]);
     udev->depcmd[ep].par0 = 0;
 
+    // issue the block command with the USB IRQ still masked, so the ISR
+    // cannot slip in another endpoint command between the parameter
+    // writes and the dispatch (see _dcd_cmd_wait).
+    uint8_t status = _dcd_cmd_wait(ep, CMDTYP_DEPSTRTXFER, 0);
+
     dcd_int_enable(TUD_OPT_RHPORT);
 
-    // issue the block command and pass the status
-    return _dcd_cmd_wait(ep, CMDTYP_DEPSTRTXFER, 0);
+    return status;
 }
 
